# Caddy reverse proxy — fronts the sim-engine API and Next.js frontend on
# the same origin so the browser sees relative URLs and there's no CORS or
# cross-domain WebSocket dance. App Runner terminates TLS in front of this.

{
  # Use stdout for App Runner's CloudWatch shipping. Disable persistence
  # of admin state since the container is single-instance.
  admin off
  log {
    output stdout
    format console
    level INFO
  }
}

:8080 {
  # encode is intentionally NOT applied at this level — we want SSE
  # (text/event-stream) responses to flow unbuffered. The Next.js + API
  # JSON paths get gzip from their own servers anyway.

  # SSE: /api/sim/:id/events. Tell Caddy to flush every write so the
  # browser's EventSource gets each event the moment the server enqueues it.
  reverse_proxy /api/sim/*/events localhost:8787 {
    flush_interval -1
  }

  # API + health (compressed)
  reverse_proxy /api/* localhost:8787
  reverse_proxy /health localhost:8787

  # Everything else → Next.js production server
  reverse_proxy /* localhost:3000
}
