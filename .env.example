# sim-wars — environment variables
# Copy to .env (gitignored) and fill in values.

# ─── LLM provider ──────────────────────────────────────────────────────────
# One of: ollama | openrouter | mock
LLM_PROVIDER=ollama

# Primary model id (provider-specific)
#   ollama     — e.g. qwen3:8b
#   openrouter — e.g. qwen/qwen3-8b, anthropic/claude-sonnet-4-6
LLM_MODEL=qwen3:8b

# Optional override. Defaults:
#   ollama     — http://localhost:11434
#   openrouter — https://openrouter.ai/api/v1
LLM_BASE_URL=

# OpenRouter auth (only needed when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# Optional attribution headers
OPENROUTER_REFERER=
OPENROUTER_TITLE=sim-wars

# ─── Optional "boost" fallback model ───────────────────────────────────────
# If set, personas tagged with `complexity: "fast"` are routed here (e.g.
# DEGEN/PANIC/FARMER) while standard/reasoning personas use the primary.
LLM_BOOST_PROVIDER=
LLM_BOOST_MODEL=
LLM_BOOST_BASE_URL=
LLM_BOOST_API_KEY=

# ─── Report generation (Phase 3) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Solana ────────────────────────────────────────────────────────────────
HELIUS_API_KEY=
ANCHOR_PROVIDER_URL=http://localhost:8899
ANCHOR_WALLET=~/.config/solana/id.json

# ─── API server ────────────────────────────────────────────────────────────
PORT=8787
