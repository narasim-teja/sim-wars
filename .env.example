# sim-wars — environment variables
# Copy to .env (gitignored) and fill in values.

# ─── LLM provider ──────────────────────────────────────────────────────────
# OpenRouter is the only supported provider. Local LLM (Ollama) was removed
# because the silent fallback masked misconfigured runs.
#
# `LLM_MODEL` is the model id used when no preset is configured below;
# with OPENROUTER_AGENT_PRESET set, this is ignored at request time but
# still appears in telemetry.
LLM_MODEL=qwen/qwen3-8b
LLM_BASE_URL=https://openrouter.ai/api/v1

# REQUIRED. The sim-engine will hard-fail at boot without this.
OPENROUTER_API_KEY=
# Optional attribution headers
OPENROUTER_REFERER=
OPENROUTER_TITLE=sim-wars

# ─── OpenRouter presets ────────────────────────────────────────────────────
# Presets are managed at https://openrouter.ai/settings/presets — they bundle
# model + system prompt + temperature + fallbacks under one slug. The app
# sends `model: "@preset/<slug>"` instead of a raw model id, so swapping
# models on the dashboard takes effect with no redeploy.
#
# Recommended setup for cost-efficient 50–100 agent runs:
#   - whitepaper-extractor   → Gemini 3 Flash (highest extraction quality)
#   - agent-decisions        → cheapest open model (e.g. qwen/qwen3-8b)
#   - agent-decisions-fast   → even cheaper for `complexity: "fast"` personas
#   - report-writer          → Gemini 3 Flash (post-sim narrative)

# Sim-engine: cheap open model for per-agent decisions (50–100×ticks LLM calls)
OPENROUTER_AGENT_PRESET=agent-decisions

# Sim-engine: fast/cheap model for personas tagged complexity="fast"
OPENROUTER_BOOST_PRESET=agent-decisions-fast

# Sim-engine: post-sim report generation (one call per sim) — use the higher-
# quality preset since it runs once and shapes the user-facing narrative.
OPENROUTER_REPORT_PRESET=report-writer

# ─── Solana ────────────────────────────────────────────────────────────────
# RPC resolution order: ANCHOR_PROVIDER_URL > HELIUS_API_KEY > localhost.
# Set ANCHOR_PROVIDER_URL when you have a custom endpoint, otherwise drop
# in HELIUS_API_KEY and the chain helper auto-builds the Helius URL.
HELIUS_API_KEY=
HELIUS_CLUSTER=mainnet
ANCHOR_PROVIDER_URL=http://localhost:8899
ANCHOR_WALLET=~/.config/solana/id.json

# Concurrency for on-chain agent funding (per-deploy-script Promise pool).
# Localnet test-validator: 25 (default). Helius / private RPC: 50–100.
# Public devnet: 8 to avoid rate-limiting.
DEPLOY_AGENT_CONCURRENCY=25

# ─── API server ────────────────────────────────────────────────────────────
PORT=8787

# ─── Sim-engine tunables ───────────────────────────────────────────────────
# Raise MAX_AGENTS for OASIS-scale stress tests. Default 5000.
# SIM_MAX_AGENTS=5000
# Per-tick LLM batch size (agents per parallel request). Default 12.
# SIM_BATCH_SIZE=24
