# sim-wars — environment variables
# Copy to .env (gitignored) and fill in values.

# ─── LLM provider ──────────────────────────────────────────────────────────
# OpenRouter is the only supported provider. Local LLM (Ollama) was removed
# because the silent fallback masked misconfigured runs.
#
# `LLM_MODEL` is the model id used when no preset is configured below.
# There is no fallback default — boot fails hard if neither a preset nor
# LLM_MODEL is set, which prevents silent drift to a model nobody picked.
LLM_MODEL=qwen/qwen3-8b
LLM_BASE_URL=https://openrouter.ai/api/v1

# REQUIRED. The sim-engine will hard-fail at boot without this.
OPENROUTER_API_KEY=
# Optional attribution headers
OPENROUTER_REFERER=
OPENROUTER_TITLE=sim-wars

# ─── OpenRouter presets ────────────────────────────────────────────────────
# Presets are managed at https://openrouter.ai/settings/presets — they bundle
# model + system prompt + temperature + fallbacks under one slug. The app
# sends `model: "@preset/<slug>"` instead of a raw model id, so swapping
# models on the dashboard takes effect with no redeploy.
#
# Recommended setup for cost-efficient 50–100 agent runs:
#   - whitepaper-extractor   → Gemini 3 Flash (highest extraction quality)
#   - agent-decisions        → cheapest open model (e.g. qwen/qwen3-8b)
#   - agent-decisions-fast   → even cheaper for `complexity: "fast"` personas
#   - report-writer          → Gemini 3 Flash (post-sim narrative)

# Sim-engine: cheap open model for per-agent decisions (50–100×ticks LLM calls)
OPENROUTER_AGENT_PRESET=agent-decisions

# Sim-engine: fast/cheap model for personas tagged complexity="fast"
# (retail degens, panic sellers, yield farmers — bulk of agent count).
OPENROUTER_BOOST_PRESET=agent-decisions-fast

# Sim-engine: stronger model for personas tagged complexity="reasoning"
# (whales, governance attackers, MEV bots — coordinated strategy needs more
# capable reasoning). OPTIONAL — leave unset to route reasoning items to
# the primary preset. Recommended pick: claude-sonnet-4.5 or qwen3-max.
# OPENROUTER_REASONING_PRESET=agent-decisions-reasoning

# Sim-engine: post-sim report generation (one call per sim) — use the higher-
# quality preset since it runs once and shapes the user-facing narrative.
OPENROUTER_REPORT_PRESET=report-writer

# ─── Solana ────────────────────────────────────────────────────────────────
# RPC resolution order: ANCHOR_PROVIDER_URL > HELIUS_API_KEY > localhost.
# Set ANCHOR_PROVIDER_URL when you have a custom endpoint, otherwise drop
# in HELIUS_API_KEY and the chain helper auto-builds the Helius URL.
HELIUS_API_KEY=
HELIUS_CLUSTER=mainnet
ANCHOR_PROVIDER_URL=http://localhost:8899
ANCHOR_WALLET=~/.config/solana/id.json

# Concurrency for on-chain agent funding (per-deploy-script Promise pool).
# Localnet test-validator: 25 (default). Helius / private RPC: 50–100.
# Public devnet: 8 to avoid rate-limiting.
DEPLOY_AGENT_CONCURRENCY=25

# ─── API server ────────────────────────────────────────────────────────────
PORT=8787

# ─── Sim-engine tunables ───────────────────────────────────────────────────
# Raise MAX_AGENTS for OASIS-scale stress tests. Default 5000.
# SIM_MAX_AGENTS=5000
# Per-tick LLM batch size (agents per parallel HTTP fan-out). Default 24.
# Verified safe up to 50 in the OpenRouter rate-limit spike — push higher
# for swarm-1k+ runs once you've confirmed your account's concurrency cap.
# SIM_BATCH_SIZE=24

# Pipelined batch dispatch — fires all batches concurrently up to
# SIM_MAX_INFLIGHT (default 4). Trade-off: within-tick visibility (e.g.
# INSIDER_01 seeing TREASURY_01 same-tick at delay=0) becomes a next-tick
# observation. Worth the trade for swarm-1k+ runs where sequential batch
# round-trips dominate latency. Leave OFF for fidelity-sensitive backtests.
# SIM_PIPELINE=1
# SIM_MAX_INFLIGHT=4

# ─── Activation policy ────────────────────────────────────────────────────
# Per-tick LLM activation. At 100+ agents the dominant cost is the per-tick
# LLM fan-out — most real-world wallets are dormant most ticks, so skipping
# their LLM call cuts cost without breaking cascades.
#   all (default) — every agent acts every tick. No-op for backwards compat.
#   sampled       — each agent rolls against persona.activation (default 1.0
#                   for hand-written personas, archetype-tuned for procedural
#                   rosters). Empirically -40% cost on swarm-100 LUNA, death
#                   spiral preserved.
#   volatility    — same as sampled but activation is scaled by recent
#                   price-history volatility ∈ [1, 3]. Quiet markets save
#                   the most; crashes wake everyone. Safer for fidelity.
# SIM_ACTIVATION_POLICY=all

# ─── Prompt cache strategy ────────────────────────────────────────────────
# Controls how the OpenRouter provider sends agent prompts:
#   flat (default) — one user-string message. Implicit caching fires on
#                    OpenAI, DeepSeek, Mistral 8B, Gemini 2.5 (with stable
#                    prefix) and is safe for every model. Recommended.
#   explicit       — split prompt into system content blocks with a
#                    cache_control: ephemeral breakpoint. Required for
#                    Anthropic / Qwen-plus / qwen3-coder-flash explicit
#                    caching. WARNING: disables Mistral 8B implicit cache
#                    — only switch on when your preset model is on the
#                    explicit-cache list.
# SIM_LLM_CACHE_MODE=flat
